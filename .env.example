# 前端构建期配置：复制为根目录 .env 后填写。
# .env 已被 .gitignore 忽略；本文件只放占位值，不要填真实私有凭据。

# 更新清单（latest.json）地址，CI 发版时删旧传新维护
VITE_LATEST_URL=https://cdn.example.com/file/sfm/installer/latest.json

# 自有分发域名：前置包、致谢名单等静态资源的基址（末尾不要带斜杠）
# 未配置时前置下载点里的自有 CDN 项与感谢名单卡片不会渲染
VITE_IMGBED_URL=https://cdn.example.com

# 前置包备用源：蓝奏云分享页链接（留空则该下载点不显示）
VITE_LANZOU_BEPINEX=
VITE_LANZOU_V2=
VITE_LANZOU_FONT=
VITE_LANZOU_RMMOSAIC=

# GitHub 仓库（owner/repo）：Releases 备用更新源与 User-Agent
VITE_GITHUB_REPO=your_name/your_repo

# 夸克网盘安装包下载入口（可选，留空则不显示）
VITE_QUARK_URL=
