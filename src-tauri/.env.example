# 桌面端公开配置（复制此文件为 .env 后填入）
#
# hk 架构下桌面端不再持有数据库 / 字段加密 / 图床凭据：
# - 数据库、加密、缓存全部在服务端，配置见 server/.env；
# - 新上传的文件直传 hk 服务器，不需要 IMGBED_TOKEN。

# 云 API 基址（必填）：所有 /api/user/rpc 请求的前缀，形如 https://api.example.com/api/user
# 构建期经 build.rs 注入二进制；运行时 SFMMM_API_BASE 环境变量可覆盖。缺失时客户端会提示
# 「未配置云 API 基址」而不是去访问一个写死的地址。
SFMMM_API_BASE=https://api.example.com/api/user

# 旧图床域名（仅用于读取历史图片/安装包直链；新版文件不走这里）
IMGBED_URL=https://your-imgbed-host.example.com

# 发版上传安装包改走管理网关（admin 域名 + X-Admin-Token，令牌取 server/.env 的 ADMIN_TOKEN），
# 不再需要图床 Token。

# 线路 2（可选）：与 IMGBED_URL 指向同一 R2 桶的第二域名（你自己的加速域名），
# 主域被污染/出问题时用户可切；「资源加速 → CDN 加速」即选它。
# 启动时对两个域名测速，更快者生效；不配置则始终用 IMGBED_URL。
IMGBED_MIRROR_URL=https://your-mirror-host.example.com
# 线路 3（可选）：同桶的第三个自定义域名。
IMGBED_LINE3_URL=

# ── 源库（旧直连 MySQL，仅本地发版脚本用）────────────────
# pnpm release 会直连这个库更新 version_config，让仍直连旧库的客户端也能看到新版本；
# 新桌面端不读这个库。不想写源库时用 pnpm release --no-src-db。
# DB_URL=mysql://user:password@host:3306/database

# ── 夸克网盘 CLI（仅发布脚本用）──────────────────────────
# scripts/vendor/quark 内置 CLI 的 SDK clientInfo。缺失时 `pnpm quark ...` 与
# `pnpm release` 的夸克上传步骤会直接报错；不影响客户端构建与运行。
QUARK_CLIENT_ID=your_quark_client_id
QUARK_SIGN_KEY=your_quark_sign_key

# ── 项目仓库（客户端 User-Agent 用）──────────────────────
# 形如 owner/repo，构建期注入 UA：sfmmm/<版本> (https://github.com/<owner>/<repo>)。
# 未配置时 UA 省略括号部分。
GITHUB_REPO=your_name/your_repo

# ── 传输信封加密（/api/user/rpc 双向）────────────────────
# 64 位十六进制，与 server/.env 的 DESKTOP_XPORT_KEY 一致（与 DB_ENC_KEY 无关）。
# 构建期经 build.rs 注入二进制；未配置时 RPC 全程明文（服务端也保持兼容）。
# 该密钥随安装包分发，仅防链路/代理/日志侧明文，不是数据库密钥。
DESKTOP_XPORT_KEY=your_64_hex_chars_here

# ── 发版直传 R2（仅构建机使用，不注入客户端）────────────────────
# 配置后 pnpm release 直接以 S3 API 把安装包/清单写进桶，不经过服务器。
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
