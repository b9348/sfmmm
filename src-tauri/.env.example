# 云数据库配置（复制此文件为 .env 后填入）
DB_URL=mysql://user:password@host:port/database
DB_URL2=mysql://user:password@backup-host:port/database

# 各线路是否强制 TLS（1=强制，0=否，缺省时线路2按强制处理）
# 线路1 若换成强制 TLS 的库（例如把 TiDB 填进 DB_URL），必须改成 DB_TLS1=1，否则连接会失败
DB_TLS1=0
DB_TLS2=1

# 数据库字段加密密钥（64 位十六进制 = 32 字节；生成: openssl rand -hex 32）
# 更换该密钥会导致已存数据无法解密
DB_ENC_KEY=your_64_hex_encryption_key

# 图床配置
IMGBED_URL=https://your-imgbed-host.example.com
IMGBED_TOKEN=your_imgbed_token_here
